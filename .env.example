# ==============================================================================
# TriQuery: Environment Configuration
# Copy this file to .env and replace placeholders with your local environment values.
# DO NOT commit real passwords or production secrets to source control.
# ==============================================================================

# Application Environment
TRIQUERY_ENV=development
LOG_LEVEL=INFO

# Relational Engine (MySQL 8.x) Configuration
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=triquery_db
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Testing / Standalone Mode
# Set to 'true' (or DB_DRIVER=sqlite) to run against an isolated SQLite replica for testing without MySQL server
DB_TEST_SQLITE_FALLBACK=false

# Graph Engine (NetworkX) Configuration
GRAPH_DIRECTED=true

# Vector Engine Configuration
# Strategy options: 'tfidf' (pure scikit-learn, zero setup), 'sentence_transformer' (local dense embeddings)
VECTOR_BACKEND=tfidf
VECTOR_TOP_K=5
VECTOR_SIMILARITY_THRESHOLD=0.15

# Query Planner & Fusion
FUSION_DEFAULT_STRATEGY=reciprocal_rank_fusion
FUSION_RRF_K=60
